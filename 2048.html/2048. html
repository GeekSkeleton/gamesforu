
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>2048 | GamesforU</title>
<style>
*{box-sizing:border-box}
body{
  margin:0;min-height:100vh;padding:20px;
  font-family:Arial,sans-serif;color:#fff;
  background:radial-gradient(circle at top,#173b75,#07152e 70%);
  display:flex;justify-content:center;align-items:center;
}
.game{width:100%;max-width:480px}
header{display:flex;justify-content:space-between;align-items:center;margin-bottom:20px}
a{color:#9dcaff;text-decoration:none;font-weight:bold}
h1{font-size:42px;margin:10px 0}
.subtitle{color:#a9bddb;font-size:14px}
.top{display:flex;gap:10px;align-items:center}
.scorebox{
  background:#18345d;border:1px solid #41628d;
  border-radius:12px;padding:9px 16px;text-align:center;min-width:85px
}
.scorebox small{display:block;color:#b9cce6;font-size:11px}
.scorebox strong{font-size:21px}
.buttons{display:flex;gap:10px;margin:18px 0}
button{
  border:0;border-radius:10px;padding:12px 16px;
  background:#327de0;color:white;font-weight:bold;font-size:14px;
  cursor:pointer;flex:1
}
button.secondary{background:#25456f}
button:disabled{opacity:.4;cursor:not-allowed}
#message{min-height:22px;color:#b9cce6;font-size:14px;margin-bottom:10px}
.board{
  display:grid;grid-template-columns:repeat(4,1fr);gap:9px;
  background:#142b4c;border:1px solid #31547e;
  padding:10px;border-radius:15px;touch-action:none;
}
.cell{
  aspect-ratio:1;border-radius:9px;background:#29415f;
  display:flex;justify-content:center;align-items:center;
  font-size:clamp(22px,7vw,34px);font-weight:800;color:#fff;
}
.v2{background:#dceaff;color:#19365d}
.v4{background:#b9d9ff;color:#19365d}
.v8{background:#76b5ff}
.v16{background:#4c94f0}
.v32{background:#3275d0}
.v64{background:#245bb0}
.v128{background:#e9c85d;color:#27334b;font-size:clamp(19px,6vw,29px)}
.v256{background:#e9b94b;color:#27334b;font-size:clamp(19px,6vw,29px)}
.v512{background:#edaa37;color:#27334b;font-size:clamp(19px,6vw,29px)}
.v1024,.v2048,.vbig{background:#f08b35;color:#fff;font-size:clamp(16px,5vw,25px)}
.instructions{color:#a9bddb;font-size:13px;line-height:1.6;margin-top:18px}
@media(max-width:380px){body{padding:12px}.board{gap:6px;padding:7px}.cell{border-radius:7px}}
</style>
</head>
<body>
<main class="game">
  <header>
    <div>
      <a href="./">← GamesforU</a>
      <h1>2048</h1>
      <div class="subtitle">Join the tiles and reach 2048!</div>
    </div>
    <div class="top">
      <div class="scorebox"><small>SCORE</small><strong id="score">0</strong></div>
      <div class="scorebox"><small>BEST</small><strong id="best">0</strong></div>
    </div>
  </header>

  <div class="buttons">
    <button onclick="newGame()">New Game</button>
    <button class="secondary" id="undo" onclick="undoMove()" disabled>↶ Undo</button>
  </div>

  <div id="message">Use the arrow keys or swipe to move the tiles.</div>
  <div class="board" id="board"></div>

  <div class="instructions">
    <b>How to play:</b> Swipe in any direction on your phone, or use your keyboard arrow keys. Matching numbers combine when they touch. Reach 2048 to win!
  </div>
</main>

<script>
const SIZE=4;
let grid,score,best,previous=null,won=false,over=false;
const board=document.getElementById("board");
const scoreEl=document.getElementById("score");
const bestEl=document.getElementById("best");
const undoBtn=document.getElementById("undo");
const message=document.getElementById("message");

best=Number(localStorage.getItem("gamesforu2048best")||0);

function emptyGrid(){
  return Array.from({length:SIZE},()=>Array(SIZE).fill(0));
}

function addTile(){
  const empty=[];
  for(let r=0;r<SIZE;r++)
    for(let c=0;c<SIZE;c++)
      if(grid[r][c]===0)empty.push([r,c]);

  if(!empty.length)return;
  const [r,c]=empty[Math.floor(Math.random()*empty.length)];
  grid[r][c]=Math.random()<0.9?2:4;
}

function render(){
  board.innerHTML="";
  for(let r=0;r<SIZE;r++){
    for(let c=0;c<SIZE;c++){
      const value=grid[r][c];
      const cell=document.createElement("div");
      cell.className="cell";
      if(value){
        cell.textContent=value;
        cell.classList.add(value<=2048?"v"+value:"vbig");
      }
      board.appendChild(cell);
    }
  }
  scoreEl.textContent=score;
  bestEl.textContent=best;
  undoBtn.disabled=!previous;
}

function newGame(){
  grid=emptyGrid();
  score=0;
  previous=null;
  won=false;
  over=false;
  addTile();
  addTile();
  message.textContent="Use the arrow keys or swipe to move the tiles.";
  render();
}

function saveUndo(){
  previous={
    grid:grid.map(row=>row.slice()),
    score,
    won,
    over
  };
}

function undoMove(){
  if(!previous)return;
  grid=previous.grid.map(row=>row.slice());
  score=previous.score;
  won=previous.won;
  over=previous.over;
  previous=null;
  message.textContent="Move undone.";
  render();
}

function slide(row){
  let arr=row.filter(v=>v!==0);
  for(let i=0;i<arr.length-1;i++){
    if(arr[i]===arr[i+1]){
      arr[i]*=2;
      score+=arr[i];
      arr.splice(i+1,1);
      if(arr[i]===2048&&!won){
        won=true;
        message.textContent="🎉 You reached 2048! Keep playing!";
      }
    }
  }
  while(arr.length<SIZE)arr.push(0);
  return arr;
}

function move(direction){
  if(over)return;

  const old=grid.map(row=>row.slice());
  const oldScore=score;
  let next=emptyGrid();

  if(direction==="left"||direction==="right"){
    for(let r=0;r<SIZE;r++){
      let row=grid[r].slice();
      if(direction==="right")row.reverse();
      row=slide(row);
      if(direction==="right")row.reverse();
      next[r]=row;
    }
  }else{
    for(let c=0;c<SIZE;c++){
      let col=[];
      for(let r=0;r<SIZE;r++)col.push(grid[r][c]);
      if(direction==="down")col.reverse();
      col=slide(col);
      if(direction==="down")col.reverse();
      for(let r=0;r<SIZE;r++)next[r][c]=col[r];
    }
  }

  const changed=JSON.stringify(old)!==JSON.stringify(next);
  if(!changed){score=oldScore;return;}

  saveUndo();
  grid=next;
  addTile();

  if(score>best){
    best=score;
    localStorage.setItem("gamesforu2048best",best);
  }

  render();

  if(!won)message.textContent="Nice move! Keep going.";
  if(!canMove()){
    over=true;
    message.textContent="Game over! Start a new game to play again.";
  }
}

function canMove(){
  for(let r=0;r<SIZE;r++){
    for(let c=0;c<SIZE;c++){
      if(grid[r][c]===0)return true;
      if(c< SIZE-1&&grid[r][c]===grid[r][c+1])return true;
      if(r< SIZE-1&&grid[r][c]===grid[r+1][c])return true;
    }
  }
  return false;
}

document.addEventListener("keydown",e=>{
  const keys={
    ArrowLeft:"left",
    ArrowRight:"right",
    ArrowUp:"up",
    ArrowDown:"down"
  };
  if(keys[e.key]){
    e.preventDefault();
    move(keys[e.key]);
  }
});

let startX=0,startY=0;
board.addEventListener("touchstart",e=>{
  const t=e.changedTouches[0];
  startX=t.clientX;
  startY=t.clientY;
},{passive:true});

board.addEventListener("touchend",e=>{
  const t=e.changedTouches[0];
  const dx=t.clientX-startX;
  const dy=t.clientY-startY;
  if(Math.max(Math.abs(dx),Math.abs(dy))<25)return;
  if(Math.abs(dx)>Math.abs(dy)){
    move(dx>0?"right":"left");
  }else{
    move(dy>0?"down":"up");
  }
},{passive:true});

newGame();
</script>
</body>
</html>
